{
	"compilerOptions": {
		"paths": {
			"@assets/*": ["./src/assets/*"],
			"@columns/*": ["./src/columns/*"],
			"@components/*": ["./src/components/*"],
			"@constants/*": ["./src/constants/*"],
			"@filters/*": ["./src/filters/*"],
			"@forms/*": ["./src/forms/*"],
			"@fragments/*": ["./src/graphql/fragments/*"],
			"@generated/*": ["./src/generated/*"],
			"@helpers/*": ["./src/helpers/*"],
			"@hooks/*": ["./src/hooks/*"],
			"@layout/*": ["./src/layout/*"],
			"@models/*": ["./src/models/*"],
			"@mutations/*": ["./src/graphql/mutations/*"],
			"@queries/*": ["./src/graphql/queries/*"],
			"@schemas/*": ["./src/schemas/*"],
			"@themes/*": ["./src/themes/*"],
			"@types/*": ["./src/types/*"],
			"@/*": ["./src/*"]
		},
		"target": "ESNext",
		"useDefineForClassFields": true,
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"allowJs": false,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx"
	},
	// e2e is type-checked too. It was not, so `tsc --noEmit` passed over 40 spec
	// files and a spec with a missing import was only caught by a five-minute
	// Playwright run - which is how it was found. Two errors existed when this was
	// added, both real.
	"include": ["src", "src/vite-env.d.ts", "types/**/*.d.ts", "e2e"]
}
