# DCB Admin — local development environment.
#
# Copy to `.env` (which is gitignored) and fill in. Every value here is also a key in
# the deployed runtime config, `docker/production/inject_env.json`, rendered from
# container env vars at startup — so a flag can be flipped per environment without
# rebuilding the UI.
#
# The FEATURE FLAGS at the bottom are the part that will bite you. They are off unless
# explicitly set to `true`, and several of them decide the SHAPE OF A GRAPHQL DOCUMENT
# rather than whether a component renders. A field the server has never heard of is not
# a null — it is a validation error that fails the whole operation — so a flag that
# disagrees with your dcb-service takes a whole page down.
#
# The thresholds below are checked against `SERVICE_CAPABILITIES` in
# src/constants/serviceCapabilities.ts by envExample.test.ts, so this list cannot drift
# from the code. That file is the source of truth; this one is the reminder.


# ── Required ──────────────────────────────────────────────────────────────────────

# dcb-service's root. An ABSOLUTE url, so requests bypass the dev server entirely.
# A bare path such as `/api` is routed through vite's dev proxy instead, which needs
# VITE_ILL_API_BASE set or every call 502s (see below).
VITE_DCB_API_BASE=http://localhost:8080

VITE_KEYCLOAK_URL=https://keycloak.example.com/realms/your-realm
VITE_KEYCLOAK_ID=dcb-admin

# MUI X Premium. Without it the data grids still work but every one of them carries a
# watermark and logs a missing-licence error.
VITE_MUI_X_LICENSE_KEY=


# ── Optional ──────────────────────────────────────────────────────────────────────

# dcb-locate, which backs the search pages. Unset disables search.
VITE_DCB_SEARCH_BASE=

# Target for the dev server's `/api` proxy, and NOTHING else — no application code
# reads it. Leave it unset if VITE_DCB_API_BASE is absolute. If you point
# VITE_DCB_API_BASE at `/api` you MUST set this, because http-proxy resolves the
# target per request: unset, every `/api/*` call answers 502 and the dev log blames
# the rewritten path (`/api/info` is logged as `/info`), which reads like a broken
# endpoint rather than a missing variable.
#
# Note this is also the preview server's proxy — vite resolves preview config as
# `preview?.proxy ?? server.proxy` — so it is in front of all three Playwright gates.
VITE_ILL_API_BASE=

# Deployment base path, for serving several OpenRS apps under prefixes on one origin
# (e.g. `/dcb-admin/`). Defaults to `/`.
VITE_PUBLIC_URL=

# Where to send a user whose roles belong to the libraries app rather than this one.
VITE_DCB_ADMIN_FOR_LIBRARIES_URL=

# The discovery front end's root, used to link an administrator to its staff pages.
# Ignored unless it is an http(s) address.
VITE_DISCOVERY_URL=


# ── Feature flags ─────────────────────────────────────────────────────────────────
#
# `since` is the dcb-service release that first has the capability. `unreleased` means
# it is on a branch or on main and in NO release — do not switch those on against a
# tagged build expecting them to work.
#
# `document` marks a flag that changes a GraphQL selection set or mutation variables.
# Turning one ON against a dcb-service that predates it fails the operation outright.

# Not a dcb-service capability: it says what the CONSORTIUM runs, not what the server
# serves, so it has no version threshold. Gates the surfaces that configure a
# discovery front end, and nothing a dcb-service release can provide.
VITE_FEATURE_SYMPOSIA=false

# since 9.0.0 · document · THE ONE FLAG THAT IS WRONG IN BOTH DIRECTIONS.
# It is the only capability with a `fallback`: with it OFF the consortium queries ask
# for 8.71.0's `headerImageUrl`/`aboutImageUrl`, which V9_0_004 DELETED. So against a
# 9.x or main dcb-service, leaving this false fails LoadConsortium and
# LoadConsortiumHeader — the setup wizard, the whole consortium section, and the header
# on every page. Set it to true on anything from 9.0.0 onwards.
VITE_FEATURE_CONSORTIUM_BRANDING=false

# since 9.0.0
VITE_FEATURE_NCIP_ONBOARDING=false
VITE_FEATURE_INSIGHTS=false
VITE_FEATURE_GUARDED_CLEANUP=false

# since 9.1.0 · document
VITE_FEATURE_LIBRARY_USER_PROVISIONING=false
VITE_FEATURE_LOCAL_HOLDS=false

# unreleased · document — `supportUrl` is on no branch this workspace can see, main
# included (checked 2026-09-29 against main bcfe8254e). schema.graphqls declares it so
# the documents validate, but no server answers it. Leave off.
VITE_FEATURE_CONSORTIUM_SUPPORT_URL=false

# unreleased · document — on the `symposia` branch only. ANDed with VITE_FEATURE_SYMPOSIA.
VITE_FEATURE_ANNOUNCEMENTS=false

# unreleased · document
VITE_FEATURE_SETTINGS_INHERITANCE=false

# unreleased · document — ANDed with VITE_FEATURE_SYMPOSIA, since the classification
# only exists to order a discovery shelf browse.
VITE_FEATURE_SHELF_BROWSE=false

# unreleased — `/insights/trend` is merged to main but in no release. A RENDER gate, not
# a document one: the rest of the subject comes from endpoints every Insights deployment
# has, so this is safe to leave off on an older server.
VITE_FEATURE_INSIGHTS_TRENDS=false

# unreleased · document — `auditIncidence` is on dcb-service `feat/analytics`, unmerged.
VITE_FEATURE_AUDIT_EXPLORER=false
