	shortName: String!
	abbreviatedName: String!
	address: String!
	type: String!
	contacts: [PersonInput]!
	longitude: Float
	latitude: Float
	# V-11.1. Both are rendered as an href in the patron app's footer, so both must be
	# an absolute http(s) URL naming a host. An explicit null or an empty string clears
	# the field. patronWebsite answers opening hours and joining; supportUrl is where a
	# patron reports that discovery itself is wrong.
	patronWebsite: String
	supportUrl: String
	discoverySystem: String
	hostLmsConfiguration: String
	targetLoanToBorrowRatio: String
	supportHours: String
	backupDowntimeSchedule: String
	reason: String
	changeCategory: String
	changeReferenceUrl: String
	isSupplyingAgency: Boolean
	isBorrowingAgency: Boolean
	maxConsortialLoans: Int
