input UpdateConsortiumInput {
	id: ID!
	description: String
	catalogueSearchUrl: String
	# V-11.1. Rendered as an href in the patron app's footer: an absolute http(s) URL
	# naming a host, and an explicit null or empty string clears the field.
	websiteUrl: String
	supportUrl: String
	displayName: String
	reason: String!
	changeCategory: String!
	changeReferenceUrl: String
	contacts: [UpdatePersonInput]
	# The brand (N-1.3), one set of marks for every DCB app. Sending an explicit null or
	# an empty string CLEARS the field; omitting the key leaves it alone.
	brandLogoUrl: String
	brandLogoAlt: String
	# R-17d. The header icon is a SQUARE mark for the app bar and the favicon, not a
	# small logo: the logo is a lockup and a 32x32 box has no horizontal room. The
	# background is the canvas behind the landing hero, consortium level only.
	# Both accept an absolute http(s) URL or a path under this service's asset prefix.
	brandHeaderIconUrl: String
	brandBackgroundImageUrl: String
	# Patron-facing copy under the search box. NOT `description`, which is staff prose.
	patronWelcome: String
	# A name from the discovery app's theme registry, not a colour. Rejected on write
	# if it is not in dcb.branding.theme-names.
	defaultThemeName: String
}

input UpdateLocationInput {
	id: ID!
	latitude: Float
	longitude: Float
	isPickup: Boolean
	isEnabledForPickupAnywhere: Boolean
	name: String
	printLabel: String
	localId: String
	reason: String
	changeReferenceUrl: String
	changeCategory: String
}

input UpdateLibraryInput {
	id: ID!
	backupDowntimeSchedule: String
	supportHours: String
	latitude: Float
	longitude: Float
	fullName: String
	shortName: String
	targetLoanToBorrowRatio: String
	abbreviatedName: String
	reason: String
	changeReferenceUrl: String
	changeCategory: String
	secretLabel: String
	principalLabel: String
	address: String
	type: String
	patronWebsite: String
	supportUrl: String
	# V-22.2. DEWEY | LCC. Explicit null or empty clears it, withdrawing the library from
	# shelf browse; an unrecognised value is REFUSED rather than ignored, or the form would
	# show a value the server did not store.
	classificationScheme: String
	discoverySystem: String
	# Patron-facing brand (N-1.3). patronWebsite above is the logo's link target, so
	# there is no second URL here. Explicit null or empty string clears the field.
	brandLogoUrl: String
	brandLogoAlt: String
	defaultThemeName: String
}

input UpdatePersonInput {
	id: ID!
	firstName: String
