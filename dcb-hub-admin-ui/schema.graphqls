	name: String!
	groupName: String!
	dateOfLaunch: String!
	# The brand marks (N-1.3). These replaced headerImageUrl/aboutImageUrl in V9_0_004:
	# the square header mark and the larger mark, one set for every DCB app.
	brandHeaderIconUrl: String
	brandLogoUrl: String
	description: String
	catalogueSearchUrl: String
	websiteUrl: String
	supportUrl: String
	displayName: String!
	reason: String!
	changeCategory: String!
	changeReferenceUrl: String
	contacts: [PersonInput]
	functionalSettings: [FunctionalSettingInput]
}

input ConsortiumContactInput {
	firstName: String!
	lastName: String!
	role: String!
	isPrimaryContact: Boolean!
	email: String!
	consortiumId: String!
	reason: String!
	changeCategory: String!
	changeReferenceUrl: String
}

