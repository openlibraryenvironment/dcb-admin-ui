	consortiumId: ID!
	reason: String
	changeReferenceUrl: String
	changeCategory: String
}

# V-12. Something a library or consortium needs to tell its patrons.
#
# headline and body are PLAIN TEXT and there is deliberately no markup field: operator-
# authored markup rendered into every patron's page is stored XSS with an admin form
# attached. expiresAt is required and there is no "never" value - the failure mode of every
# announcement banner is the notice from March still up in November.
type Announcement {
	id: ID
	scopeType: String
	scopeId: ID
	headline: String
	body: String
	urgent: Boolean
	dismissible: Boolean
	startsAt: String
	expiresAt: String
	lastEditedBy: String
	reason: String
	changeCategory: String
	changeReferenceUrl: String
	dateCreated: String
	dateUpdated: String
}

input CreateAnnouncementInput {
	# CONSORTIUM | LIBRARY_GROUP | LIBRARY
	scopeType: String!
	scopeId: ID!
	headline: String!
	body: String!
	urgent: Boolean
	dismissible: Boolean
	# ISO-8601 instants. Both required: a start lets an operator write Monday's notice on
	# Friday, and an end is what stops it outliving what it was about.
	startsAt: String!
	expiresAt: String!
	reason: String
	changeCategory: String
	changeReferenceUrl: String
}

# The scope is absent on purpose. Moving a library's notice to consortium scope by editing
# it would widen its reach to every patron of every member library through a path that never
# asks the question the create path asks; a misplaced notice is withdrawn and republished.
input UpdateAnnouncementInput {
	id: ID!
	headline: String
	body: String
	urgent: Boolean
	dismissible: Boolean
	startsAt: String
	expiresAt: String
	reason: String
	changeCategory: String
	changeReferenceUrl: String
}

# N-3 / V-22.6. One functional setting as it resolves for one scope.
type ResolvedFunctionalSetting {
	name: FunctionalSettingType!
	# The effective value. False when `source` is null, matching the behaviour every
	# existing caller depends on: a setting nobody has configured is off.
	enabled: Boolean!
	# LIBRARY | LIBRARY_GROUP | CONSORTIUM, or null when NO level has a row. Null is a
	# distinct answer from consortium-and-false: "nobody has said" and "the consortium said
	# no" lead an administrator to do different things.
	source: String
	sourceId: ID
	# The consortium, group or library name, so the UI can say where a value came from
	# without a second query.
	sourceName: String
	# True when the deciding row sits at a level broader than the one asked about.
	inherited: Boolean!
	description: String
	lastEditedBy: String
	dateUpdated: String
}

# What one scoped write did. A summary rather than the resulting values: a bulk-set may name
# five hundred libraries, and `changed` is what actually moved, which a revert makes
# different from what was asked for.
type FunctionalSettingScopeChange {
	name: FunctionalSettingType!
	scopeType: String!
	changed: Int!
	scopeIds: [ID!]!
}

input SetFunctionalSettingAtScopesInput {
	# LIBRARY | LIBRARY_GROUP. CONSORTIUM is refused: while the legacy functional_setting
	# tables exist the consortium level has exactly one writer, the consortium functional
	# settings page, and ConsortiumFunctionalSettingMirror projects it onto the scope row.
	scopeType: String!
	# At most 500 - the member-library scale constant, so "every library in the consortium"
	# fits in one call and nothing larger does.
	scopeIds: [ID!]!
	name: FunctionalSettingType!
	enabled: Boolean!
	description: String
	reason: String!
	changeCategory: String
	changeReferenceUrl: String
}

input RevertFunctionalSettingAtScopesInput {
	scopeType: String!
	scopeIds: [ID!]!
	name: FunctionalSettingType!
	# Stamped on each row before it is removed. The audit trigger writes the row a statement
	# fired for, so without it the log would record the reason the value was last SET as
	# though that were why it was withdrawn.
	reason: String!
	changeCategory: String
	changeReferenceUrl: String
}

input DeleteEntityInput {
	id: ID!
	reason: String
	changeReferenceUrl: String
	changeCategory: String
}

input DeleteLibraryContactInput {
