  id: ID!
}

type PatronIdentity {
  id: ID!
  localId: String
  homeIdentity: Boolean
  localBarcode: String
  localNames: String
  localPtype: String
  canonicalPtype: String
  localHomeLibraryCode: String
  lastValidated: String
  # The library this patron belongs to, resolved from their home location during
  # patron validation. The only place a request records it: patronHostlmsCode names
  # the system, which on a shared one is every co-tenant rather than any of them.
  resolvedAgency: Agency
}

type Location {
  id: ID!
  dateCreated: String
  dateUpdated: String
  code: String
  name: String
  type: String
  agency: Agency
  parentLocation: Location
  hostSystem: HostLms
  isPickup: Boolean
	longitude: Float
  latitude: Float
  locationReference: String
  deliveryStops: String
  printLabel: String
  localId: String
	lastImported: String
	isEnabledForPickupAnywhere: Boolean
}

type Library {
	id: ID!
	agencyCode: String
	fullName: String
	shortName: String
	abbreviatedName: String
	training: Boolean
	backupDowntimeSchedule: String
	supportHours: String
	discoverySystem: String
	patronWebsite: String
	supportUrl: String
	# V-22.2. DEWEY | LCC, or null for a library that has not stated one - which is a
	# library shelf browse is NOT offered for, rather than one defaulted to Dewey.
	classificationScheme: String
	hostLmsConfiguration: String
	longitude: Float
	latitude: Float
	address: String
	agency: Agency
	type: String
	contacts: [Person]
	secondHostLms: HostLms
	membership: [LibraryGroupMember]
	principalLabel: String
	secretLabel: String
	targetLoanToBorrowRatio: String
	# Patron-facing brand (N-1.3), read by dcb-admin-for-libraries' library form.
	brandLogoUrl: String
	brandLogoAlt: String
	defaultThemeName: String
}

type LibraryContact {
	id: ID
	library: Library
	person: Person
}

type LibraryGroup {
	id: ID!
	name: String!
	code: String!
	type: String!
	members: [LibraryGroupMember]
	consortium: Consortium
}

type LibraryGroupMember {
	id: ID!
	library: Library
	libraryGroup: LibraryGroup
}

type Person {
	id: ID
	firstName: String
	lastName: String
	role: Role!
	isPrimaryContact: Boolean
	email: String
}

type Consortium {
	id: ID!
	name: String!
	libraryGroup: LibraryGroup!
	dateOfLaunch: String
	description: String
	catalogueSearchUrl: String
	websiteUrl: String
	supportUrl: String
	displayName: String
	contacts: [Person]
	reason: String
	changeReferenceUrl: String
	changeCategory: String
	functionalSettings: [FunctionalSetting]
	# The brand (N-1.3), read by dcb-admin-ui's consortium form and served to patrons
	# by /discovery/consortium. There is deliberately no uploader field: who changed a
	# mark is in dataChangeLog, not on this type.
	brandLogoUrl: String
	brandLogoAlt: String
	# R-17d — square app-bar mark, and the landing canvas.
	brandHeaderIconUrl: String
	brandBackgroundImageUrl: String
	patronWelcome: String
	defaultThemeName: String
}

type ConsortiumContact {
	id: ID
	consortium: Consortium
	person: Person
}

type DataChangeLog {
	id: ID!
