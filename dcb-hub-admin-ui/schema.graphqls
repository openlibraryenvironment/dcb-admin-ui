# THE NEWEST SCHEMA THIS APP TARGETS - dcb-service `symposia` at c2b037f2e, the last
# commit on that branch to touch its schema.graphqls: everything Symposia needs from
# dcb-service, on one branch. Four capabilities, all four unmerged - §V-11.1's
# `supportUrl` (V9_0_008__support_url), §N-3's scoped functional settings
# (V9_0_009__functional_setting_scope), §V-12's announcements (V9_0_010__announcement)
# and §V-22.2's `classificationScheme` (V9_0_011__library_classification_scheme).
#
# NOT on dcb-service main, and no longer a superset of it: main has moved on since the
# 2026-09-09 merge into symposia, and its V9_0_008, 009 and 010 are three DIFFERENT
# migrations. Merging symposia renumbers all four of the above.
#
# That branch exists so these three applications can be developed and tested against one
# contract before it merges; nothing here reaches a deployment before it does, because
# every capability row that depends on it carries `since: null` and its flag is off
# everywhere.
#
# Taken verbatim from that ref, plus ONE addition at the end of this file: auditIncidence
# and its two types, from dcb-service `feat/audit-incidence` (fdde88c01), which is the
# branch scheduled to merge them - MERGE_PLAN.md item 17. The identical block is also on
# `feat/analytics` and `audit-explorer`, so name the scheduled branch rather than whichever
# one a grep lands in first. They are here so the Audit Explorer's documents can be
# validated against something; no release serves them, which is why
# VITE_FEATURE_AUDIT_EXPLORER is off everywhere and its capability row carries since: null.
#
# Re-take this file whenever either branch moves, and re-run codegen.
#
scalar JSON

type Query {
    agencies(query: String, pageno: Int, pagesize: Int, order: String, orderBy: String): AgencyPage!
    hostLms(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): HostLmsPage!
    locations(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): LocationPage!
    patronRequests(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): PatronRequestPage
    supplierRequests(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): SupplierRequestPage!
    inactiveSupplierRequests(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): InactiveSupplierRequestPage!
    agencyGroups(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): AgencyGroupPage!
    instanceClusters(query: String, pageno: Int, pagesize: Int, order: String, orderBy: String): ClusterRecordPage!
    sourceBibs(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): BibRecordPage!
    processStates(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): ProcessStatePage!
    audits(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): PatronRequestAuditPage!
    patronIdentities(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): PatronIdentityPage!
    numericRangeMappings(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): NumericRangeMappingPage!
    referenceValueMappings(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): ReferenceValueMappingPage!
		pickupLocations(forAgency: String): [Location]
		libraries(query: String, pageno: Int, pagesize: Int, order: String, orderBy: String): LibraryPage!
		libraryGroups(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): LibraryGroupPage!
		libraryGroupMembers: [LibraryGroupMember]!
		consortia(query: String, pageno:Int, pagesize: Int, order: String, orderBy: String): ConsortiumPage!
		dataChangeLog(query: String, pageno: Int, pagesize: Int, order: String, orderBy: String): DataChangeLogPage!
		roles(query: String, pageno: Int, pagesize: Int, order: String, orderBy: String): RolePage!
		functionalSettings(query: String, pageno: Int, pagesize: Int, order: String, orderBy: String): FunctionalSettingPage!
		alarms(query: String, pageno: Int, pagesize: Int, order: String, orderBy: String): AlarmPage!
		patronRequestStatistics(startDate: String,endDate: String,borrowerCodes:[String] ,pickupCodes: [String],
			statusCodes: [String], supplierCodes: [String], bibClusterId: ID): [DailyPatronRequestStat]!
		# One library's DCB Admin for Libraries accounts. Deliberately NOT consortium-wide:
		# a library's staff list is tens of rows, and a roster across 500 libraries is a
		# different query with different scale properties that nothing has asked for.
		libraryUsers(libraryId: ID!): [LibraryUser!]!
		# Whether this deployment has an identity provider configured at all, so the UI can
		# hide a tab that could only fail rather than render a form nobody can submit.
		libraryUserProvisioningAvailable: Boolean!
		# From dcb-service `feat/analytics`; see this file's header. No RELEASE serves it.
		auditIncidence(query: String, interval: String, start: String, end: String): AuditIncidence!
		# V-12. Everything at one scope, live or not - the admin list. A patron reads the LIVE
		# ones from /discovery/announcements, which is anonymous and has no query language.
		announcements(scopeType: String!, scopeId: ID!): [Announcement!]!
		# N-3 / V-22.6. Every functional setting as it resolves for one scope, with the
		# level that decided it. The provenance is the point: a control that shows a value
		# without saying whether this scope chose it or is following its parent makes a
		# bulk-set a one-way door.
		resolvedFunctionalSettings(scopeType: String!, scopeId: ID!): [ResolvedFunctionalSetting!]!
		# V-22.6b. Which LibraryGroup.type carries settings on this deployment, so the admin
		# UI can name the group level. Null means there is none and the chain is library
		# then consortium.
		settingsBearingGroupType: String
}

type Mutation {
		updateAgencyParticipationStatus(input: UpdateAgencyParticipationInput): Agency!
		createAgencyGroup(input: AgencyGroupInput): AgencyGroup!
    addAgencyToGroup(input: AddAgencyToGroupCommand): AgencyGroupMember!
		deleteContact(input: DeleteConsortiumContactInput): DeleteEntityPayload!
		createContact(input: ConsortiumContactInput): ConsortiumContact!
		createConsortium(input: ConsortiumInput): Consortium!
		deleteConsortium(input: DeleteEntityInput): DeleteEntityPayload!
		updateConsortium(input: UpdateConsortiumInput): Consortium!
		updateFunctionalSetting(input: UpdateFunctionalSettingInput): FunctionalSetting!
		createFunctionalSetting(input: FunctionalSettingInput): FunctionalSetting!
		# V-12. A consortium announcement reaches every patron of every member library, so
		# consortium scope needs CONSORTIUM_ADMIN; a library administrator may publish for a
		# library they actually administer, and the scope of an existing one cannot be edited.
		createAnnouncement(input: CreateAnnouncementInput): Announcement!
		updateAnnouncement(input: UpdateAnnouncementInput): Announcement!
		deleteAnnouncement(input: DeleteEntityInput): DeleteEntityPayload!
		# N-3 / V-22.6. One setting, explicitly, at one or many LIBRARY or LIBRARY_GROUP
		# scopes. The same mutation for one scope and for forty: a separate single-scope
		# one would be a second copy of the same rules that would eventually disagree.
		setFunctionalSettingAtScopes(input: SetFunctionalSettingAtScopesInput): FunctionalSettingScopeChange!
		# The half that stops a bulk-set being a one-way door. Removes the explicit rows so
		# those scopes inherit again - NOT the same as writing the parent's value into them,
		# which would make a scope that chose and a scope that never chose indistinguishable.
		revertFunctionalSettingToInherited(input: RevertFunctionalSettingAtScopesInput): FunctionalSettingScopeChange!
		createLibrary(input: LibraryInput): Library!
		deleteLibrary(input: DeleteEntityInput): DeleteEntityPayload!
		updateLibrary(input: UpdateLibraryInput): Library!
		createLibraryContact(input: CreateLibraryContactInput): LibraryContact!
		deleteLibraryContact(input: DeleteLibraryContactInput): DeleteEntityPayload!
		addLibraryToGroup(input: AddLibraryToGroupCommand): LibraryGroupMember!
		createLibraryGroup(input: LibraryGroupInput): LibraryGroup!
		createLocation(input: CreateLocationInput): Location!
		deleteLocation(input: DeleteEntityInput): DeleteEntityPayload!
		updateLocation(input: UpdateLocationInput): Location!
		updateReferenceValueMapping(input: UpdateReferenceValueMappingInput): ReferenceValueMapping!
		deleteNumericRangeMapping(input: DeleteEntityInput): DeleteEntityPayload!
		updateNumericRangeMapping(input: UpdateNumericRangeMappingInput): NumericRangeMapping!
		updatePerson(input: UpdatePersonInput): Person!
		createReferenceValueMapping(input: CreateReferenceValueMappingInput): ReferenceValueMapping!
		deleteReferenceValueMapping(input: DeleteEntityInput): DeleteEntityPayload!
		createRole(input: CreateRoleInput): Role!
		updateRole(input: UpdateRoleInput): Role!
		updateConsortialMaxLoans(input: UpdateConsortialMaxLoansInput): Agency!
		updateAgency(input: UpdateAgencyInput): Agency!
	  createHostLms(input: CreateHostLmsInput!): CreateHostLmsResult
		updateHostLms(input: UpdateHostLmsInput!): UpdateHostLmsResult
		provisionLibraryUser(input: ProvisionLibraryUserInput): LibraryUser!
		setLibraryUserEnabled(input: SetLibraryUserEnabledInput): LibraryUser!
		resendLibraryUserInvite(input: ResendLibraryUserInviteInput): LibraryUser!

}

input AddAgencyToGroupCommand {
        agency: ID!
        group: ID!
}

input AddLibraryToGroupCommand {
	library: ID!
	libraryGroup: ID!
}

enum FunctionalSettingType {
	OWN_LIBRARY_BORROWING
  PICKUP_ANYWHERE
	RE_RESOLUTION
	SELECT_UNAVAILABLE_ITEMS
  TRIGGER_SUPPLIER_RENEWAL
	DENY_LIBRARY_MAPPING_EDIT
	VIRTUAL_PATRON_NAMES_VISIBLE,
	VIRTUAL_PATRON_NAMES_POLARIS
}

enum ProcessingStatus {
	PROCESSING_REQUIRED,
	SUCCESS,
	FAILURE
}

enum RenewalStatus {
	ALLOWED,
	DISALLOWED,
	UNKNOWN,
	UNSUPPORTED
}


"""
Graphql does not allow types to be reused as input types as the semantics are different. We create the input types here.
AgencyGroupInput : fields that define a new agency group.
"""
input AgencyGroupInput {
    id: ID
    code: String!
    name: String!
}

input ConsortiumInput {
