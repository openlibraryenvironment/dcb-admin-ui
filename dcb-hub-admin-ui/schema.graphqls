# ---------------------------------------------------------------------------
# DCB Admin for Libraries accounts
#
# The enum is gate one of four on the role: a request naming ADMIN is a GraphQL
# validation error before any resolver runs. It is not the security control -
# ProvisionableRole.parse, the Postgres CHECK constraint and the identity provider's
# own role-mapping grant are the others - but it is free and it removes a class of
# mistake at the boundary.
# ---------------------------------------------------------------------------

enum ProvisionableRole {
	LIBRARY_ADMIN
	LIBRARY_READ_ONLY
}

enum LibraryUserStatus {
	INVITED
	ACTIVE
	DISABLED
}

# Note the ABSENCE of an agencyCode field. It is derived server-side from libraryId, so
# a client that cannot name an agency cannot scope an account to somebody else's library.
input ProvisionLibraryUserInput {
	libraryId: ID!
	email: String!
	firstName: String
	lastName: String
	role: ProvisionableRole!
	reason: String
	changeCategory: String
	changeReferenceUrl: String
}

input SetLibraryUserEnabledInput {
	id: ID!
	enabled: Boolean!
	reason: String
	changeCategory: String
	changeReferenceUrl: String
}

input ResendLibraryUserInviteInput {
	id: ID!
}

# No password field exists on this type, deliberately, and none ever should. The
# credential flow is entirely the provider's actions email.
type LibraryUser {
	id: ID!
	identityProviderUserId: String!
	libraryId: ID!
	agencyCode: String!
	email: String!
	firstName: String
	lastName: String
	role: ProvisionableRole!
	status: LibraryUserStatus!
	dateCreated: String
	lastEditedBy: String
}


# ---------------------------------------------------------------------------
# From dcb-service `feat/analytics`, which is unmerged. See this file's header.
# ---------------------------------------------------------------------------

type AuditIncidenceBucket {
  "ISO-8601 start of the interval (UTC)."
  bucketStart: String!
  count: Int!
}

type AuditIncidence {
  "Echoed back so the client can label the axis: HOUR | DAY | WEEK."
  interval: String!
  "Total matching audits across the whole window (sum of bucket counts)."
  totalSize: Int!
  "Continuous, gap-filled, ascending by bucketStart."
  buckets: [AuditIncidenceBucket!]!
}
