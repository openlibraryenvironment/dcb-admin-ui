		"@mui/material": "9.5.0",
		"@mui/x-charts-pro": "9.16.0",
		"@mui/x-data-grid-premium": "9.16.0",
		"@mui/x-date-pickers-pro": "9.16.0",
		"@mui/x-license": "9.16.0",
		"@tanstack/react-query": "5.104.5",
		"@tanstack/react-router": "1.170.46",
