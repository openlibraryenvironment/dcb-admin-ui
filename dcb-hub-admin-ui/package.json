{
	"name": "dcb-admin-ui",
	"version": "2.1.0",
	"private": true,
	"license": "FSL-1.1-ALv2",
	"scripts": {
		"codegen": "graphql-codegen --config codegen.ts",
		"coverage": "vitest run --coverage",
		"dev": "vite",
		"build": "tsc && vite build",
		"verify": "npm run build && vitest run",
		"lint": "eslint",
		"preview": "vite preview",
		"semantic-release": "semantic-release",
		"test": "vitest",
		"prepare": "cd .. && husky dcb-hub-admin-ui/.husky",
		"build:vite": "vite build",
		"budget": "node scripts/check-bundle-budget.mjs",
		"ci:lint": "node scripts/ci-lint.mjs",
		"report": "node scripts/release-report.ts",
		"gates": "node scripts/check-all-gates.mjs",
		"e2e": "playwright test",
		"e2e:base-path": "playwright test --config playwright.base-path.config.ts",
		"e2e:ki-bootstrap": "playwright test --config playwright.ki-bootstrap.config.ts",
		"e2e:container": "docker rm -f dcb-admin-container-gate && playwright test --config playwright.container.config.ts",
		"e2e:ui": "playwright test --ui",
		"i18n:missed": "i18n-unused display-missed",
		"i18n:unused": "i18n-unused display-unused",
		"i18n:mark-unused": "i18n-unused mark-unused",
		"i18n:remove-unused": "i18n-unused remove-unused",
		"lighthouse": "lhci autorun"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
